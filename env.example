# =============================================================================
# PumpBot - file environment (.env)
# =============================================================================
# CARA PAKAI
#   1. Salin file ini menjadi .env di folder utama project (sejajar run.py):
#        Linux/macOS : cp .env.example .env
#        Windows CMD : copy .env.example .env
#   2. Isi hanya bagian yang Anda butuhkan. Hapus tanda # di depan baris
#      yang ingin diaktifkan.
#   3. Simpan file. Restart bot supaya nilai baru terbaca.
#
# ATURAN PENULISAN
#   - Format: NAMA=nilai  (tanpa spasi di sekitar tanda =)
#   - Tanpa tanda kutip, kecuali nilainya memang mengandung spasi
#   - Satu variabel per baris
#   - Baris berawalan # adalah komentar dan diabaikan
#
# KEAMANAN (WAJIB DIBACA)
#   - JANGAN PERNAH commit file .env ke GitHub. Pastikan ".env" tercantum
#     di file .gitignore Anda.
#   - JANGAN tempel isi .env yang sudah terisi ke chat, forum, atau screenshot.
#   - Mode bot (paper / testnet / live) TIDAK diatur di sini. Mode diatur
#     di config/config.yaml pada baris:  mode: paper
#   - Semua parameter strategi (SL, TP, threshold, bobot detector, dll)
#     juga ada di config/config.yaml, bukan di file ini.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. API KEY BINANCE
# -----------------------------------------------------------------------------
# Kapan dibutuhkan:
#   - mode: paper    -> TIDAK dibutuhkan (simulasi internal). Biarkan baris
#                       di bawah tetap dikomentari.
#   - mode: testnet  -> WAJIB, pakai key dari testnet.binance.vision
#   - mode: live     -> WAJIB, pakai key dari akun Binance asli
#
# Cara membuat key TESTNET (gratis, saldo virtual):
#   1. Buka https://testnet.binance.vision
#   2. Login dengan akun GitHub
#   3. Buka tab "API Key", klik "Generate HMAC Key"
#   4. Salin API Key dan Secret Key ke dua baris di bawah
#   Catatan: data testnet direset berkala (tiap beberapa hari). Saldo dan
#   order bisa hilang, itu normal. Bila key tiba-tiba ditolak, buat ulang.
#
# Cara membuat key LIVE (hanya setelah testnet stabil berminggu-minggu):
#   1. Binance > Profil > API Management > Create API
#   2. AKTIFKAN  : "Enable Spot & Margin Trading"
#   3. JANGAN aktifkan "Enable Withdrawals" (bot tidak butuh ini)
#   4. Batasi akses ke IP tetap milik Anda (Restrict access to trusted IPs)
#   5. Secret hanya ditampilkan sekali. Simpan segera. Jika hilang, buat baru.
#
# Hapus tanda # lalu ganti nilainya:

BINANCE_API_KEY=ganti_dengan_api_key_anda
BINANCE_API_SECRET=ganti_dengan_secret_key_anda

# -----------------------------------------------------------------------------
# 2. DASHBOARD WEB (opsional)
# -----------------------------------------------------------------------------
# Jika tidak diisi, bot memakai host dan port dari config/config.yaml.
# Jika diisi, nilai di sini menimpa nilai di YAML.
#
# DASHBOARD_HOST
#   127.0.0.1 : hanya bisa dibuka dari komputer Anda sendiri (DISARANKAN)
#   0.0.0.0   : bisa dibuka dari perangkat lain di jaringan
#   PERINGATAN: dashboard punya kontrol yang bisa menutup posisi dan
#   mengubah parameter risiko. README tidak menyebut adanya login, jadi
#   jangan buka ke jaringan publik atau internet tanpa perlindungan tambahan
#   (firewall, VPN, atau reverse proxy dengan autentikasi).
#
# DASHBOARD_PORT
#   Port bebas yang belum dipakai aplikasi lain. Contoh 8000.
#   Dashboard lalu dibuka di http://localhost:PORT
#

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# -----------------------------------------------------------------------------
# 3. NOTIFIKASI TELEGRAM (opsional)
# -----------------------------------------------------------------------------
# Fungsi: bot mengirim pesan saat start, stop, dan saat halt harian.
# Kedua variabel harus diisi berpasangan, kalau tidak notifikasi tidak jalan.
#
# Cara mendapatkan TELEGRAM_BOT_TOKEN:
#   1. Di Telegram, cari akun resmi @BotFather
#   2. Kirim perintah /newbot, ikuti langkahnya (nama dan username bot)
#   3. BotFather memberi token, bentuknya seperti 123456789:AAxxxxxxxx
#
# Cara mendapatkan TELEGRAM_CHAT_ID:
#   1. Buka bot Anda di Telegram, tekan Start, kirim satu pesan apa saja
#   2. Buka di browser (ganti TOKEN dengan token Anda):
#        https://api.telegram.org/botTOKEN/getUpdates
#   3. Cari bagian "chat":{"id":...}. Angka itu adalah chat id Anda.
#      Untuk grup, id biasanya berupa angka negatif.
#
# Token bot sama sensitifnya dengan password. Jangan dibagikan.
#
#TELEGRAM_BOT_TOKEN=ganti_dengan_token_dari_botfather
#TELEGRAM_CHAT_ID=ganti_dengan_chat_id_anda

# -----------------------------------------------------------------------------
# 4. LEVEL LOG (opsional)
# -----------------------------------------------------------------------------
# Menimpa level logging di config/config.yaml. Log tersimpan di logs/bot.log.
# Nilai standar Python logging:
#   DEBUG    : paling detail, cocok untuk mencari bug (file log cepat membesar)
#   INFO     : normal, disarankan untuk penggunaan harian
#   WARNING  : hanya peringatan dan masalah
#   ERROR    : hanya error
#
#LOG_LEVEL=INFO
